# JR Jewellers — environment template. Copy to .env.local and fill in.
#
# ⚠️ BUILD-TIME vs RUNTIME. Every NEXT_PUBLIC_* value below is inlined into the
# compiled output by `next build` — it is NOT read from the environment at
# runtime. In Docker/Dokploy they must be passed as **build args** (they are,
# see Dockerfile + docker-compose.yml), and changing one needs a **rebuild**,
# not a restart. Everything else here is a normal runtime variable.
#
# ── IN PRODUCTION (the deploy platform's Environment panel) ───────────────────
#   Required — the app will not work without these:
#     NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
#     NEXT_PUBLIC_SITE_URL, SUPABASE_SECRET_KEY
#   Optional — each feature is a graceful no-op when unset, never a crash:
#     RESEND_API_KEY / EMAIL_FROM / ADMIN_ALERT_EMAIL  (email)
#     CRON_SECRET                                      (daily digest, 503s without it)
#     VAPID_*                                          (admin push)
#   Never set in production:
#     E2E_USER_EMAIL / E2E_USER_PASSWORD — test credentials; the suite writes
#     real orders. RAZORPAY_* / SHIPROCKET_* — unread by any code today.
#
# Env vars are not the whole deploy. These live in the database, not here, and
# are easy to miss on a fresh project — see docs/DEPLOY_DOKPLOY.md §9:
#   • `supabase/seed.sql` — creates the `setting` singleton; without it every
#     admin Settings save fails with SETTINGS_ROW_MISSING.
#   • `insert into app_secret (name, value) values ('cron', '<CRON_SECRET>');`
#     — must match the env var above or the digest RPC refuses.
#   • The first admin — stamped by hand in auth.users (seed.sql §2 has the SQL).
#   • Supabase Auth SITE_URL + redirect allowlist pointed at the real domain.

# Supabase (storefront, public client config). Works against either managed
# Supabase Cloud (sb_publishable_xxx / sb_secret_xxx) or a self-hosted stack
# (legacy eyJ... anon/service_role JWTs) — see docs/SELF_HOSTED_SUPABASE.md.
#
# Self-hosted note: both keys are signed with the stack's JWT_SECRET, so they
# are only valid for the stack that generated them. If the Supabase stack is
# recreated, its secrets are regenerated and BOTH keys below must be copied
# again from the stack's env — a stale key fails with a bare "Unauthorized"
# from Kong that looks nothing like an auth problem.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only — the admin console (lib/db/admin.ts) bypasses RLS with this;
# required for any /admin write. Never NEXT_PUBLIC_*. Self-hosted: this is the
# stack's SERVICE_ROLE_KEY, and it must come from the same generation as the
# publishable key above.
# SUPABASE_SECRET_KEY=sb_secret_xxx

# Absolute site origin (sitemap/robots/metadataBase/JSON-LD) — optional,
# falls back to http://localhost:3000 in dev. Set to the real domain at deploy.
# Build-time (see the note at the top): sitemap.xml and robots.txt are
# prerendered, so setting this only at runtime ships localhost URLs to Google.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Transactional email (TASKS 4.6) — optional; without a key, checkout works
# but sends nothing (confirmation-page copy adapts). Server-only secrets.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM="RJ Jewellers <orders@your-domain.com>"  # needs a verified domain;
#                                                     # defaults to onboarding@resend.dev
# ADMIN_ALERT_EMAIL=owner@your-domain.com  # new-order alerts (TASKS 5.2);
#                                          # defaults to the store email

# Daily digest cron (TASKS 5.17) — optional. Long random string; the SAME value
# must be inserted once into the sealed app_secret table (see
# supabase/migrations/0001_initial_schema.sql):
#   insert into app_secret (name, value) values ('cron', '<same value>');
# The scheduler then hits GET /api/cron/daily-digest with
# "Authorization: Bearer $CRON_SECRET" once a day after IST close.
# CRON_SECRET=  # Generate using openssl rand -hex 32,

# Admin push notifications (6.17) — Web Push keypair for admin console alerts
# (new order/review/message). Optional; without keys the Settings →
# Notifications card shows "not configured" and nothing sends. Also requires
# CRON_SECRET above (the push sender reads subscriptions through the same
# secret-gated RPC). Generate a key pair once:
#   bunx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:owner@your-domain.com  # contact URI sent to push services;
#                                             # defaults to the site URL

# E2E tests (`bun run e2e`) — only needed to run the Playwright suite, never in
# a deployed environment. The checkout journey is sign-in only, so it needs a
# real account that already exists in the target Supabase project; Bun injects
# these from .env.local when the suite runs.
#
# `supabase/seed_demo.sql` creates a ready-made one:
#   E2E_USER_EMAIL=demo@rjjewellers.in
#   E2E_USER_PASSWORD=DemoUser@2026
#
# ⚠️ The suite writes REAL orders into whatever project it points at, tagged
# with E2E_USER_EMAIL so they can be cleaned up afterwards:
#   delete from "order" where customer_email = '<E2E_USER_EMAIL>';
# (order_item rows cascade.) Point it at a dev/staging project, not production.
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=

# Deferred to a later phase (v1 is COD-only — see CLAUDE.md); not yet read by
# any code in this repo.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
